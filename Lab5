      "source": [
        "# Task 5 — define X and y, encode categorical columns\n",
        "num_features     = [\"OverallQual\", \"GrLivArea\", \"GarageCars\", \"TotalBsmtSF\",\n",
        "                    \"YearBuilt\", \"FullBath\", \"LotArea\"]\n",
        "ordinal_features = [\"ExterQual\", \"KitchenQual\"]          # Po < Fa < TA < Gd < Ex\n",
        "binary_features  = [\"CentralAir\"]                         # Y / N\n",
        "nominal_features = [\"Neighborhood\", \"BldgType\"]           # no natural order\n",
        "\n",
        "quality_map = {\"Po\": 1, \"Fa\": 2, \"TA\": 3, \"Gd\": 4, \"Ex\": 5}\n",
        "train_medians = df[num_features].median()                 # fill values come from TRAIN only\n",
        "\n",
        "def prepare(data, columns=None):\n",
        "    \"\"\"Apply the exact same feature selection + encoding to any dataframe.\"\"\"\n",
        "    X_ = data[num_features + ordinal_features + binary_features + nominal_features].copy()\n",
        "    for c in num_features:\n",
        "        X_[c] = X_[c].fillna(train_medians[c])\n",
        "    for c in ordinal_features:\n",
        "        X_[c] = X_[c].fillna(\"TA\").map(quality_map)\n",
        "    X_[\"CentralAir\"] = X_[\"CentralAir\"].map({\"Y\": 1, \"N\": 0})\n",
        "    X_ = pd.get_dummies(X_, columns=nominal_features, drop_first=True, dtype=float)\n",
        "    if columns is not None:                               # align test columns to train columns\n",
        "        X_ = X_.reindex(columns=columns, fill_value=0)\n",
        "    return X_.astype(float)\n",
        "\n",
        "y = df[\"SalePrice\"]\n",
        "X = prepare(df)\n",
        "print(\"X shape:\", X.shape)\n",
        "X.head()"
