        "# Task 3 — define X and y (same as Lab 3/4)\n",
        "y = (df[\"Churn\"] == \"Yes\").astype(int)\n",
        "X = df.drop(columns=[\"Churn\", \"customerID\"])            # identifier dropped from features only\n",
