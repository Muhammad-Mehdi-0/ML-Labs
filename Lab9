        "def eval_scores(y_true, proba, thr=0.5):\n",
        "    \"\"\"Six metrics from predicted probabilities at a chosen threshold.\"\"\"\n",
        "    pred = (np.asarray(proba) >= thr).astype(int)\n",
        "    return {\"Accuracy\": accuracy_score(y_true, pred),\n",
        "            \"Precision\": precision_score(y_true, pred, zero_division=0),\n",
        "            \"Recall\": recall_score(y_true, pred),\n",
        "            \"F1\": f1_score(y_true, pred),\n",
        "            \"ROC AUC\": roc_auc_score(y_true, proba),\n",
        "            \"PR AUC\": average_precision_score(y_true, proba)}\n",
        "\n",
        "def evaluate_model(model, Xtr, ytr, Xte, yte, thr=0.5):\n",
        "    \"\"\"Fit a model on the train data and return the six metrics on the test data.\"\"\"\n",
        "    model.fit(Xtr, ytr)\n",
        "    return eval_scores(yte, model.predict_proba(Xte)[:, 1], thr)\n",
        "\n",
        "dummy = DummyClassifier(strategy=\"most_frequent\")\n",
        "dummy_scores = evaluate_model(dummy, X_train_s, y_train, X_test_s, y_test)\n",
        "print(\"Baseline accuracy (always predict 'no stroke'):\", round(dummy_scores[\"Accuracy\"], 4))"
      ],
