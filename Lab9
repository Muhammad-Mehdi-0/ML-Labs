        "}\n",
        "def uses_scaled(name):\n",
        "    return name == \"Logistic Regression\"\n",
        "\n",
        "fractions = [0, 0.05, 0.10, 0.20]\n",
        "label_rows = []\n",
        "for frac in fractions:\n",
        "    reps = 1 if frac == 0 else 5\n",
        "    row = {\"Noise fraction\": frac}\n",
        "    for name, mk in noise_models.items():\n",
        "        aucs = []\n",
